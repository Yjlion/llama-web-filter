{
  "proxy_listen": [
    "127.0.0.1:8080",
    "socks5@127.0.0.1:1080"
  ],
  "mgmt_host": "127.0.0.1",
  "mgmt_port": 8000,
  "mgmt_tls": false,
  "mgmt_cert_file": "",
  "mgmt_key_file": "",
